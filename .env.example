# Demo storage configuration (QA-06).
# SQLite database file used by the API when CASE_DB_PATH is set.
# Defaults to ./db.sqlite3 when unset. Mount a persistent volume at the
# chosen path for deployment (see DEP-02).
CASE_DB_PATH=./db.sqlite3

# LLM configuration (API-07, LLM-03). All values are server-side only and
# must never be committed, logged, or returned by the API.
# Leave LLM_API_KEY empty to run with controlled unavailable explanations.
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=demo-explainer-1.0
LLM_TIMEOUT_S=30
