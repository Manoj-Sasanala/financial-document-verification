{"chunk_id": "POL-RISK-005#chunk-005", "source_id": "POL-RISK-005", "version": "1.0.0", "title": "Reference customer not found rule", "section_heading": "Boundary", "chunk_index": 5, "text": "## Boundary\n\nA failed reference lookup must not be replaced with an invented customer record. The indicator does not determine the final human decision.", "char_start": 792, "char_end": 946, "source_path": "data/policy/sources/POL-RISK-005-reference-customer-not-found.md", "provenance": {"task_id": "RAG-02", "schema_version": "1.0.0", "generator": "rag-chunking/1.0.0", "corpus_id": "kyc-demo-policy-corpus", "corpus_version": "1.0.0", "source_manifest": "data/policy/manifest.json"}}
