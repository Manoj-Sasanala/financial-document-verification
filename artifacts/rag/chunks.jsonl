{"chunk_id": "POL-RISK-001#chunk-001", "source_id": "POL-RISK-001", "version": "1.0.0", "title": "Name mismatch rule", "section_heading": "Purpose", "chunk_index": 1, "text": "## Purpose\n\nDefine the controlled demo rule for a mismatch between the document customer name and the synthetic reference customer's name.", "char_start": 166, "char_end": 306, "source_path": "data/policy/sources/POL-RISK-001-name-mismatch.md", "provenance": {"task_id": "RAG-02", "schema_version": "1.0.0", "generator": "rag-chunking/1.0.0", "corpus_id": "kyc-demo-policy-corpus", "corpus_version": "1.0.0", "source_manifest": "data/policy/manifest.json"}}
